# =============================================================================
# MeetScribe Backend Environment Configuration
# =============================================================================

# Database Connection (PostgreSQL or SQLite fallback)
# Option A: Full Connection URL (Recommended for Railway, Supabase, Neon, AWS RDS, Docker)
DATABASE_URL=postgresql://meetscribe_user:meetscribe_password@localhost:5432/meetscribe

# Option B: Individual PostgreSQL Connection Parameters (used if DATABASE_URL is not set)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=meetscribe
# POSTGRES_USER=meetscribe_user
# POSTGRES_PASSWORD=meetscribe_password

# Option C: SQLite fallback (used when DATABASE_URL is unset or starts with sqlite://)
# SQLITE_DB_PATH=/path/to/meetscribe.db

# Authentication Security (Change in production!)
AUTH_SECRET_KEY=meetscribe_super_secret_jwt_session_key_2026_change_in_production
TOKEN_EXPIRE_DAYS=7

# Upload Directory for Audio Recordings (MP3, WAV, WebM)
# UPLOAD_DIR=/path/to/uploads/audio

# CORS Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Automated Database Seeding (Set to false in production with pre-seeded data)
AUTO_SEED=true
